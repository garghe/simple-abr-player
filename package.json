{
  "name": "simple-abr-player",
  "version": "1.0.0",
  "private": true,
  "description": "Web player for clear MPEG-DASH and HLS streams with stats-for-nerds and SCTE-35 inspection",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample": "node scripts/make-sample.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e:drm": "node scripts/e2e-drm.mjs"
  },
  "dependencies": {
    "shaka-player": "^5.2.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "undici": "^7.30.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
